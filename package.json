{
  "name": "@christhackrey/git-changelog-generator",
  "version": "1.0.1",
  "description": "AI-powered changelog generator for Git repositories",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "changelog-generator": "./bin/changelog-generator.js",
    "changelog-hooks": "./bin/install-hooks.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "lint": "eslint . --ext .ts",
    "prepare": "pnpm run build",
    "postinstall": "node ./bin/install-hooks.js"
  },
  "keywords": [
    "git",
    "changelog",
    "ai",
    "typescript",
    "openai",
    "anthropic",
    "claude"
  ],
  "author": "Chris Thackrey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christhackrey/git-changelog-generator.git"
  },
  "bugs": {
    "url": "https://github.com/christhackrey/git-changelog-generator/issues"
  },
  "homepage": "https://github.com/christhackrey/git-changelog-generator#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/server-sequential-thinking": "^0.6.2",
    "@modelcontextprotocol/server-memory": "^0.6.2",
    "@modelcontextprotocol/server-filesystem": "^2025.3.28",
    "@modelcontextprotocol/server-brave-search": "^0.6.2",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "fs-extra": "^11.3.0",
    "simple-git": "^3.27.0",
    "node-fetch": "^3.3.2",
    "nanoid": "^5.1.5",
    "openai": "^4.94.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
